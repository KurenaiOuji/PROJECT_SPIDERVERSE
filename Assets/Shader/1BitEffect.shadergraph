    "m_Slots": [
        {
            "m_Id": "9529abb7f266463a94a1e839479b897a"
        },
        {
            "m_Id": "da31adcfb15d4f788ce16c52fc67d0b2"
        },
        {
            "m_Id": "ce6c14a13973432c802a0526ef4339ac"
        },
        {
            "m_Id": "6a018abc002a4b24890015185092b19f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Dither",
    "m_FunctionSource": "",
    "m_FunctionBody": "\n    float2 uv = ScreenPosition.xy * screenParams;\n    float DITHER_THRESHOLDS[16] =\n    {\n        1.0 / 17.0,  9.0 / 17.0,  3.0 / 17.0, 11.0 / 17.0,\n        13.0 / 17.0,  5.0 / 17.0, 15.0 / 17.0,  7.0 / 17.0,\n        4.0 / 17.0, 12.0 / 17.0,  2.0 / 17.0, 10.0 / 17.0,\n        16.0 / 17.0,  8.0 / 17.0, 14.0 / 17.0,  6.0 / 17.0\n    };\n    uint index = (uint(uv.x) % 4) * 4 + uint(uv.y) % 4;\n    Out = In - DITHER_THRESHOLDS[index];"
}

