    "m_ObjectId": "1ab17ef26c8b4ef7be63650ae8fb9880",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Dither (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -650.4998779296875,
            "y": 269.49993896484377,
